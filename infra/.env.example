# Copy to infra/.env. Both optional.
# Overrides agents.gateway in pdlc.yaml; used verbatim, include /v1 if the server expects it.
PDLC_LLM_BASE_URL=
# Leave blank for an endpoint that does not check authentication.
PDLC_LLM_API_KEY=

# Self-hosted Langfuse LLM tracing (optional): disabled by default — leaving it unset/false means
# the Tiltfile never applies infra/k8s/langfuse.yaml (no images pulled, no pods) and the four
# LANGFUSE_* values default blank, which nulls AgentRunTracer.traceUrl() (no dead links into a
# server that isn't running). BUILD_AGENT_TOKEN and PDLC_DEMO_ENABLED above/below are also read
# straight from this file into the pdlc-env Secret.
# Setting LANGFUSE_ENABLED=true alone is enough — the four keys below default to
# pk-lf-pdlc-local/sk-lf-pdlc-local/http://localhost:3000/pdlc-pilot. langfuse-web reads the same
# PUBLIC_KEY/SECRET_KEY/PROJECT_ID var names to provision its own project, so one value here
# drives both sides and they can't diverge. Keep the pk-lf-/sk-lf- prefixes on the keys (Langfuse
# validates key format on auth). The five commented lines below remain the override points.
#LANGFUSE_ENABLED=true
#LANGFUSE_PUBLIC_KEY=pk-lf-pdlc-local
#LANGFUSE_SECRET_KEY=sk-lf-pdlc-local
#LANGFUSE_PUBLIC_URL=http://localhost:3000
#LANGFUSE_PROJECT_ID=pdlc-pilot

# Shared secret the standalone build agent sends as X-Agent-Token; empty (default) = open on the
# local stack (control-plane runs with PDLC_IDENTITY_DEV_HEADERS=true there).
#BUILD_AGENT_TOKEN=
#
# Enterprise login (not read by the Tiltfile - set on the control-plane deployment; see
# docs/phase-1-execution-spec.md slice 2):
#   SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_PDLC_ISSUER_URI=https://idp.example.com/realms/acme
#   SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_PDLC_CLIENT_ID=pdlc-ui
#   SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_PDLC_CLIENT_SECRET=...
#   SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_PDLC_SCOPE=openid,profile,email
#   SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://idp.example.com/realms/acme
#   SPRING_APPLICATION_JSON={"pdlc":{"identity":{"role-mapping":{"pdlc-po":"PO","pdlc-admins":"Admin"}}}}
#   PDLC_WEBHOOK_TOKEN=...   (board webhooks send it as X-Webhook-Token)
# Service callers use client credentials: build-worker PDLC_OAUTH_TOKEN_URL/_CLIENT_ID/_CLIENT_SECRET,
# agents PDLC_SERVICE_OAUTH_TOKEN_URL/_CLIENT_ID/_CLIENT_SECRET.
# DemoInitializer seeds the curated restaurant-demo catalog + demo-live feature on startup.
#PDLC_DEMO_ENABLED=true
