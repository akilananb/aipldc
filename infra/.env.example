# Copy to infra/.env. Both optional.
# Overrides agents.gateway in pdlc.yaml; used verbatim, include /v1 if the server expects it.
PDLC_LLM_BASE_URL=
# Leave blank for an endpoint that does not check authentication.
PDLC_LLM_API_KEY=

# Self-hosted Langfuse LLM tracing (optional): disabled by default — leave commented out and
# `docker compose up`/`pull` never touch the 6 langfuse-* containers or their images, and
# runs.trace_url stays null (no dead links into a server that isn't running) because
# LANGFUSE_PUBLIC_URL/PROJECT_ID also default blank, which nulls AgentRunTracer.traceUrl().
# To enable, uncomment all five; langfuse-web reads the same PUBLIC_KEY/SECRET_KEY/PROJECT_ID var
# names to provision its own project, so one value here drives both sides and they can't diverge.
# Keep the pk-lf-/sk-lf- prefixes on the keys (Langfuse validates key format on auth).
#COMPOSE_PROFILES=langfuse
#LANGFUSE_PUBLIC_KEY=pk-lf-pdlc-local
#LANGFUSE_SECRET_KEY=sk-lf-pdlc-local
#LANGFUSE_PUBLIC_URL=http://localhost:3000
#LANGFUSE_PROJECT_ID=pdlc-pilot
